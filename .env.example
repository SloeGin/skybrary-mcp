# SKYbrary authenticated scraper settings
SKYBRARY_USER=you@example.com
SKYBRARY_PASS=your-password
SKYBRARY_BASE_URL=https://skybrary.aero
SKYBRARY_LOGIN_URL=https://skybrary.aero/user/login
SCRAPER_USER_AGENT=MCP-Scraper/1.0
SCRAPER_ACCEPT_LANGUAGE=en-US,en;q=0.9
SCRAPER_REQUEST_TIMEOUT_SECONDS=30
SCRAPER_DELAY_SECONDS=5
SCRAPER_MAX_ATTEMPTS=5
SCRAPER_RETRY_BASE_SECONDS=5
SCRAPER_RATE_LIMIT_DELAY_SECONDS=30
SKYBRARY_BROWSER_HEADLESS=true
SKYBRARY_BROWSER_CHANNEL=
SKYBRARY_BROWSER_EXECUTABLE=

# Ollama embedding service
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mxbai-embed-large
OLLAMA_PORT=11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=60
OLLAMA_MAX_ATTEMPTS=3
EMBEDDING_DELAY_SECONDS=1
EMBEDDING_RATE_LIMIT_DELAY_SECONDS=30

# ChromaDB vector store
CHROMA_URL=http://localhost:8000
CHROMA_PORT=8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION=accidents_incidents
OPERATIONAL_ISSUES_COLLECTION=operational_issues

# RAG chunking
MIN_SECTION_CHARS=80
MAX_CHUNK_CHARS=1800
